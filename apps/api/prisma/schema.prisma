// Physical data model (MPD) for Probo.
//
// Code, database and API are written in English; the user interface is
// bilingual and the project report is in French. Translations live in
// packages/shared/src/i18n/, keyed by enum value.
//
// This schema will be derived from the Merise conceptual model once the
// mockups are done — see docs/README.md for the dependency chain of the
// design deliverables. Deviations between the two levels are documented in
// docs/conception/ecarts-mcd-mpd.md.
//
// Working rule: the conceptual model is updated in the same session as the
// Prisma migration, never afterwards.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // NestJS compiles to CommonJS. Without this, Prisma 7 emits an ESM client
  // that uses import.meta and breaks both Jest and the runtime.
  moduleFormat = "cjs"
  runtime      = "nodejs"

  // Without this, the generated client's relative imports carry a .js
  // extension that CommonJS resolution in Jest cannot map back to .ts.
  importFileExtension = ""
}

// Prisma 7: the connection URL no longer lives here. Migration commands read
// it from prisma.config.ts, and the client receives it through an adapter
// (see src/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenant and access
// ---------------------------------------------------------------------------

model Institution {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  siret     String?  @db.VarChar(14)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  campaigns    Campaign[]
  applications Application[]
  documents    Document[]
  auditEntries AuditEntry[]

  @@map("institution")
}

enum UserRole {
  ADMIN
  ADMISSIONS_OFFICER

  @@map("user_role")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  institutionId String    @map("institution_id") @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  role          UserRole  @default(ADMISSIONS_OFFICER)
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")

  /// US-01 — attempts are delayed after six consecutive failures.
  ///
  /// Counted per ACCOUNT, not per IP: an attacker spreads attempts over many
  /// addresses, and locking by IP would lock out a whole institution sitting
  /// behind one gateway. Reset to zero on every successful sign-in.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  institution        Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  importBatches      ImportBatch[]
  auditEntries       AuditEntry[]
  overriddenVerdicts DocumentAnalysis[]

  @@index([institutionId])
  @@map("user")
}

// ---------------------------------------------------------------------------
// Campaign
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED

  @@map("campaign_status")
}

enum DocumentType {
  RESUME
  COVER_LETTER
  RECOMMENDATION_LETTER
  PORTFOLIO
  OTHER

  @@map("document_type")
}

model Campaign {
  id            String         @id @default(uuid()) @db.Uuid
  institutionId String         @map("institution_id") @db.Uuid
  name          String
  description   String?
  status        CampaignStatus @default(DRAFT)

  /// Document types this campaign expects. A detected type outside this list
  /// makes the document atypical (RG-02).
  expectedTypes DocumentType[] @map("expected_types")

  /// Minimum level 1 confidence for a classification to be accepted (RG-01).
  confidenceThreshold Int @default(70) @map("confidence_threshold")

  /// Relative weight of the three level 2 sub-scores (RG-05).
  relevanceWeight     Float @default(0.5) @map("relevance_weight")
  clarityWeight       Float @default(0.25) @map("clarity_weight")
  formalQualityWeight Float @default(0.25) @map("formal_quality_weight")

  opensAt   DateTime? @map("opens_at")
  closesAt  DateTime? @map("closes_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  referenceProfiles ReferenceProfile[]
  importBatches     ImportBatch[]
  applications      Application[]

  @@index([institutionId, status])
  @@map("campaign")
}

/// What level 2 compares a document against — one per expected document type.
///
/// RG-08 — Exactly one form is filled: either `text`, a profile the institution
/// typed, or an uploaded reference file. Never both, never neither.
///
/// Replaces the former `Criterion` entity, which no user story justified
/// (see the 2026-09-03 entry in docs/journal-decisions.md).
model ReferenceProfile {
  id           String       @id @default(uuid()) @db.Uuid
  campaignId   String       @map("campaign_id") @db.Uuid
  documentType DocumentType @map("document_type")

  /// The sought profile, described in the institution's own words.
  text String?

  /// An uploaded reference document, when one was given instead of `text`.
  /// Its text goes through the same extraction chain as a candidate's file.
  fileName      String? @map("file_name")
  storageKey    String? @map("storage_key")
  extractedText String? @map("extracted_text")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, documentType])
  @@map("reference_profile")
}

// ---------------------------------------------------------------------------
// Ingestion
// ---------------------------------------------------------------------------

enum ImportBatchStatus {
  PENDING
  RUNNING

  /// Documents are unpacked and their identity read, but at least one grouping
  /// is ambiguous. No analysis starts until a human has arbitrated (RG-09).
  AWAITING_RECONCILIATION

  COMPLETED
  FAILED

  @@map("import_batch_status")
}

/// How a document ended up attached to a given candidate — kept because the
/// grouping has to be explainable, and contestable, after the fact.
enum IdentitySource {
  /// A sub-folder of the archive named the candidate.
  FOLDER
  /// The common prefix of the file names.
  FILENAME
  /// The identity read from the documents' own text.
  CONTENT
  /// A human arbitrated the grouping during reconciliation.
  MANUAL

  @@map("identity_source")
}

/// A single ZIP upload, and the outcome of unpacking it.
///
/// The archive itself is the only ingestion channel (see the 2026-08-25 entry
/// in docs/journal-decisions.md), so no source column is carried: it could only
/// ever hold one value.
model ImportBatch {
  id         String  @id @default(uuid()) @db.Uuid
  campaignId String  @map("campaign_id") @db.Uuid
  userId     String? @map("user_id") @db.Uuid

  /// Name of the uploaded archive, kept for the audit trail.
  archiveName String @map("archive_name")

  status    ImportBatchStatus @default(PENDING)
  fileCount Int               @default(0) @map("file_count")

  /// Entries refused while unpacking — unsafe path, forbidden type, or a
  /// per-file or per-archive limit exceeded (RG-07).
  rejectedFileCount Int       @default(0) @map("rejected_file_count")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([campaignId])
  @@map("import_batch")
}

// ---------------------------------------------------------------------------
// Applications and documents
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  PENDING
  RUNNING
  ANALYSED
  FAILED

  @@map("application_status")
}

model Application {
  id             String            @id @default(uuid()) @db.Uuid
  campaignId     String            @map("campaign_id") @db.Uuid
  institutionId  String            @map("institution_id") @db.Uuid
  candidateName  String            @map("candidate_name")
  candidateEmail String?           @map("candidate_email")
  externalRef    String?           @map("external_ref")
  status         ApplicationStatus @default(PENDING)

  /// Where `candidateName` came from (RG-09). `MANUAL` means a human settled
  /// it during reconciliation, which is the only source that never needs
  /// re-examining.
  identitySource IdentitySource @map("identity_source")

  /// Mean score of the retained documents (RG-06).
  /// `null` means "nothing to evaluate" — never zero.
  overallScore Float? @map("overall_score")

  atypicalDocumentCount Int @default(0) @map("atypical_document_count")

  /// Rank is never stored: it is computed at read time with a window function.
  /// A materialised rank would be invalidated by every analysed document.

  /// GDPR purge deadline. Indexed for the daily sweep.
  purgeDueAt DateTime @map("purge_due_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  documents   Document[]

  @@index([campaignId, overallScore(sort: Desc)])
  @@index([purgeDueAt])
  @@index([institutionId])
  @@map("application")
}

enum ExtractionMethod {
  NATIVE
  OCR
  FAILED

  @@map("extraction_method")
}

enum DocumentStatus {
  PENDING
  EXTRACTING
  LEVEL_1_ANALYSIS
  LEVEL_2_ANALYSIS
  COMPLETED
  FAILED

  @@map("document_status")
}

model Document {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  importBatchId String @map("import_batch_id") @db.Uuid
  institutionId String @map("institution_id") @db.Uuid

  originalFilename String @map("original_filename")
  storageKey       String @map("storage_key")

  /// Content fingerprint: detects the same file uploaded twice in one batch.
  sha256 String @db.Char(64)

  sizeBytes Int    @map("size_bytes")
  mimeType  String @map("mime_type")

  /// Candidate identity read from the document's own text (RG-09).
  ///
  /// The filename is a hint, never the authority: Probo exists because file
  /// names lie about what a document is, so they cannot be trusted about whose
  /// it is either. A mistyped type only flags one document; a wrong grouping
  /// silently corrupts two candidates' scores.
  detectedCandidateName  String? @map("detected_candidate_name")
  detectedNameConfidence Int?    @map("detected_name_confidence")

  extractionMethod ExtractionMethod? @map("extraction_method")
  status           DocumentStatus    @default(PENDING)
  errorMessage     String?           @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  importBatch ImportBatch       @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  text        DocumentText?
  analysis    DocumentAnalysis?

  @@index([applicationId])
  @@index([sha256])
  @@index([status])
  @@map("document")
}

/// Performance split: extracted text runs to tens of kilobytes and has no
/// business being loaded by list queries. Conceptually it is a plain property
/// of Document.
model DocumentText {
  documentId String   @id @map("document_id") @db.Uuid
  content    String
  charCount  Int      @map("char_count")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_text")
}

enum AtypicalReason {
  LOW_CONFIDENCE
  UNEXPECTED_TYPE
  UNREADABLE

  @@map("atypical_reason")
}

model DocumentAnalysis {
  documentId String @id @map("document_id") @db.Uuid

  // --- Level 1: nature verification ---
  detectedType    DocumentType?   @map("detected_type")
  confidence      Int?
  isAtypical      Boolean         @default(false) @map("is_atypical")
  atypicalReason  AtypicalReason? @map("atypical_reason")
  level1Rationale String?         @map("level1_rationale")

  // --- Level 2: campaign relevance (RG-04: retained documents only) ---
  relevanceScore     Int? @map("relevance_score")
  clarityScore       Int? @map("clarity_score")
  formalQualityScore Int? @map("formal_quality_score")

  relevanceRationale     String? @map("relevance_rationale")
  clarityRationale       String? @map("clarity_rationale")
  formalQualityRationale String? @map("formal_quality_rationale")

  /// Weighted mean of the three sub-scores (RG-05).
  documentScore Float? @map("document_score")

  // --- Traceability: without it, there is no explaining why the same document
  //     scored differently two weeks apart.
  /// RG-10 — a human may contradict the level 1 verdict.
  ///
  /// The model's own verdict is never overwritten: `detectedType`,
  /// `confidence` and `isAtypical` keep what the model said. The human
  /// decision is recorded beside it, so a score remains explainable — down to
  /// "a person decided otherwise, on this date, for this reason".
  ///
  /// `UNREADABLE` is not overridable: no human decision makes text appear.
  overriddenType    DocumentType? @map("overridden_type")
  overriddenById    String?       @map("overridden_by_id") @db.Uuid
  overriddenAt      DateTime?     @map("overridden_at")
  overrideRationale String?       @map("override_rationale")

  level1Model   String? @map("level1_model")
  level2Model   String? @map("level2_model")
  promptVersion String  @map("prompt_version")
  level1Tokens  Int?    @map("level1_tokens")
  level2Tokens  Int?    @map("level2_tokens")
  durationMs    Int?    @map("duration_ms")

  analysedAt DateTime @default(now()) @map("analysed_at")

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  overriddenBy User?    @relation(fields: [overriddenById], references: [id], onDelete: SetNull)

  @@index([isAtypical])
  @@map("document_analysis")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

/// Attached to the institution, never to the application: the 90-day GDPR
/// purge of applications therefore leaves the audit trail intact.
/// What was done. Bounded and knowable: one value per audited operation in
/// the use cases. A free string would send raw values to the screen, which the
/// project's i18n rule forbids.
enum AuditAction {
  USER_LOGGED_IN
  USER_LOGIN_FAILED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  REFERENCE_PROFILE_UPDATED
  BATCH_IMPORTED
  BATCH_REJECTED
  ARCHIVE_ENTRY_REJECTED
  IDENTITY_RECONCILED
  ANALYSIS_VERDICT_OVERRIDDEN
  APPLICATION_DELETED
  APPLICATION_PURGED
  RANKING_EXPORTED

  @@map("audit_action")
}

/// What the action was done to.
enum AuditEntityType {
  INSTITUTION
  USER
  CAMPAIGN
  REFERENCE_PROFILE
  IMPORT_BATCH
  APPLICATION
  DOCUMENT
  SESSION

  @@map("audit_entity_type")
}

model AuditEntry {
  id            String          @id @default(uuid()) @db.Uuid
  institutionId String          @map("institution_id") @db.Uuid
  userId        String?         @map("user_id") @db.Uuid
  action        AuditAction
  entityType    AuditEntityType @map("entity_type")
  entityId      String?         @map("entity_id")
  ipAddress     String?         @map("ip_address")
  userAgent     String?         @map("user_agent")
  details       Json?
  occurredAt    DateTime        @default(now()) @map("occurred_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([institutionId, occurredAt(sort: Desc)])
  @@map("audit_entry")
}

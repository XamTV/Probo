@startuml diagramme-cas-utilisation
' Probo — diagramme de cas d'utilisation
' Source : docs/analyse/cas-utilisation.md. Les deux se mettent à jour ensemble.
' CU-11 (import Drive) n'y figure pas : reporté hors périmètre v1 le 31/08/2026.

left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #545C66
  FontColor #14181D
}
skinparam rectangle {
  BackgroundColor #FBFBFA
  BorderColor #A9B1BA
}
skinparam arrow {
  Color #545C66
  FontColor #6C757F
  FontSize 11
}

actor "Chargé\nd'admission" as CA
actor "Administrateur" as AD
actor "Mistral AI" as IA <<système>>
actor "Planificateur" as PL <<système>>

' L'administrateur hérite de tous les cas du chargé d'admission
AD --|> CA

rectangle "Probo" {

  usecase "CU-01\nSe connecter" as CU01
  usecase "CU-04\nImporter un lot" as CU04
  usecase "CU-15\nRéconcilier l'identité\ndes candidats" as CU15
  usecase "CU-05\nAnalyser un document" as CU05
  usecase "CU-06\nSignaler un document\natypique" as CU06
  usecase "CU-07\nCalculer le score\nd'une candidature" as CU07
  usecase "CU-08\nConsulter le classement" as CU08
  usecase "CU-09\nConsulter le détail\nd'un document" as CU09
  usecase "CU-10\nExporter le classement" as CU10

  usecase "CU-02\nGérer les comptes" as CU02
  usecase "CU-03\nConfigurer une campagne" as CU03
  usecase "CU-12\nSupprimer une candidature" as CU12
  usecase "CU-13\nConsulter le journal\nd'audit" as CU13
  usecase "CU-14\nPurger les données\néchues" as CU14
}

CA --> CU01
CA --> CU04
CA --> CU08
CA --> CU09
CA --> CU10

AD --> CU02
AD --> CU03
AD --> CU12
AD --> CU13

PL --> CU14

' L'import ne peut pas lancer l'analyse sans avoir levé les doutes d'identité (RG-09)
CU04 ..> CU15 : <<include>>
CU15 ..> CU05 : <<include>>
CU05 ..> CU07 : <<include>>

' Le signalement n'a lieu que si le niveau 1 écarte le document (RG-01 à RG-03)
CU06 ..> CU05 : <<extend>>

CU05 --> IA

note bottom of CU15
  RG-09 — bloquant.
  Aucune analyse ne démarre
  tant qu'un regroupement
  douteux n'est pas tranché.
end note

@enduml

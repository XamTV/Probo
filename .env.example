# ---------------------------------------------------------------------------
# Copier en .env et remplir. Le .env réel n'est jamais committé.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=3000

# --- PostgreSQL -------------------------------------------------------------
# Ports décalés volontairement : une installation PostgreSQL ou Redis déjà
# présente sur la machine occupe 5432/6379, et `localhost` taperait dessus
# plutôt que sur le conteneur. Le symptôme est un P1010 « denied access »
# très trompeur.
POSTGRES_USER=probo
POSTGRES_PASSWORD=probo
POSTGRES_DB=probo
POSTGRES_PORT=5433
DATABASE_URL=postgresql://probo:probo@localhost:5433/probo?schema=public

# --- Redis (file BullMQ) ----------------------------------------------------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Authentification -------------------------------------------------------
# Générer avec : openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Mistral AI -------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODELE_NIVEAU_1=mistral-small-latest
MISTRAL_MODELE_NIVEAU_2=mistral-large-latest
# Plafond d'appels simultanés — à aligner sur le quota du palier souscrit.
MISTRAL_CONCURRENCE_MAX=4

# --- Google Drive (compte de service) ---------------------------------------
# Chemin vers la clé JSON du compte de service. Le fichier vit hors du dépôt.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-service-account.json

# --- Stockage des documents -------------------------------------------------
# v1 : volume disque local. Migration S3 prévue mais optionnelle.
STORAGE_DIR=./storage

# --- Ingestion : garde-fous -------------------------------------------------
INGESTION_TAILLE_MAX_FICHIER_MO=20
INGESTION_NB_MAX_FICHIERS=500

# --- RGPD -------------------------------------------------------------------
RETENTION_JOURS=90

# --- Observabilité ----------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Copier en .env et remplir. Le .env réel n'est jamais committé.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=3000

# --- PostgreSQL -------------------------------------------------------------
# Ports décalés volontairement : une installation PostgreSQL ou Redis déjà
# présente sur la machine occupe 5432/6379, et `localhost` taperait dessus
# plutôt que sur le conteneur. Le symptôme est un P1010 « denied access »
# très trompeur.
POSTGRES_USER=probo
POSTGRES_PASSWORD=probo
POSTGRES_DB=probo
POSTGRES_PORT=5433
DATABASE_URL=postgresql://probo:probo@localhost:5433/probo?schema=public

# --- Redis (file BullMQ) ----------------------------------------------------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Authentification -------------------------------------------------------
# Générer avec : openssl rand -base64 48
JWT_SECRET=
# Durée de vie de la session. Il n'y a volontairement pas de jeton de
# rafraîchissement : l'outil est consulté par séances de travail, pas en
# continu, et une rotation de jetons ajouterait une surface d'attaque et un
# stockage de secrets pour un confort dont personne n'a fait la demande.
# Une journée de travail couverte, puis on se reconnecte.
JWT_TTL=12h

# --- Mistral AI -------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_LEVEL_1_MODEL=mistral-small-latest
MISTRAL_LEVEL_2_MODEL=mistral-large-latest
# Plafond d'appels simultanés — à aligner sur le quota du palier souscrit.
MISTRAL_MAX_CONCURRENCY=4

# --- Stockage des documents -------------------------------------------------
# v1 : volume disque local. Migration S3 prévue mais optionnelle.
STORAGE_DIR=./storage

# --- Ingestion : garde-fous (RG-07) -----------------------------------------
# L'archive ZIP est le seul canal d'entrée : ces plafonds sont la seule barrière
# entre un fichier déposé par un utilisateur et le disque du serveur.
INGESTION_MAX_FILE_SIZE_MB=20
INGESTION_MAX_FILE_COUNT=4000
# Archive et volume extrait : 4 000 fichiers à 1 Mo de moyenne, hypothèse
# posée le 11/11/2026 (Q-04). Le rapport attrape la bombe de décompression ;
# la taille extraite attrape le volume honnête mais ingérable.
INGESTION_MAX_ARCHIVE_SIZE_MB=3072
INGESTION_MAX_EXTRACTED_SIZE_MB=4096
# Rapport maximal entre la taille décompressée et la taille de l'archive.
# Au-delà, l'archive est refusée sans être écrite : garde-fou anti zip bomb.
INGESTION_MAX_DECOMPRESSION_RATIO=100

# --- RGPD -------------------------------------------------------------------
RETENTION_DAYS=90

# --- Observabilité ----------------------------------------------------------
SENTRY_DSN=

# Dépendances
node_modules/

# Builds
dist/
build/
.angular/
*.tsbuildinfo

# Client Prisma généré — régénéré au postinstall, jamais committé
apps/api/src/generated/

# Environnement — ne jamais committer de secrets
.env
.env.*
!.env.example

# Clé du compte de service Google : jamais dans le dépôt
credentials/
*-service-account*.json

# Stockage local des documents candidats (données personnelles)
/storage/

# Canvas de maquettes assemblé : 2 Mo d'éditeur embarqué, régénéré depuis
# docs/maquettage/artboards/
docs/maquettage/*.html

# Schémas rendus : régénérés depuis les sources .puml, jamais committés —
# un SVG à côté de sa source est une seconde vérité à entretenir
docs/conception/*.svg
docs/conception/*.png

# Tests
coverage/
.nyc_output/
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*

# OS / éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Réglages Claude Code personnels : le hook partagé est dans
# .claude/settings.json, les surcharges locales ne regardent personne
.claude/settings.local.json

# Messages de commit préparés pour relecture. Le hook renvoie tout commit à
# l'auteur ; le message l'attend ici, à un chemin stable dans le dépôt, et non
# dans un dossier temporaire propre à une session qui aura disparu demain.
.commits/
